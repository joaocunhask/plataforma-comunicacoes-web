# Postgres (Neon via integração Vercel). Usar a ligação "pooled".
DATABASE_URL=

# Só para o ETL da prova de conceito: SQL Server de origem (cópia/snapshot, nunca escrever).
MSSQL_CONNECTION_STRING=

# Better Auth: segredo aleatório (>= 32 bytes) e o URL público da app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# App do Pipedrive (Developer Hub): OAuth e o JWT do modal. O callback é <URL público>/oauth/pipedrive/callback.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_CALLBACK_URL=
# Cifra os tokens OAuth guardados (AES-256-GCM): openssl rand -base64 32
PIPEDRIVE_TOKENS_KEY=

# Claude (extração do texto colado no modal do Pipedrive). ANTHROPIC_MODEL é opcional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
